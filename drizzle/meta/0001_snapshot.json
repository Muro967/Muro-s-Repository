      "checkConstraints": {
        "items_status_check": {
          "name": "items_status_check",
          "value": "\"items\".\"status\" in ('draft', 'active', 'watching', 'disposed')"
        },
        "items_category_check": {
          "name": "items_category_check",
          "value": "\"items\".\"category_id\" in ('tops', 'bottoms', 'outerwear', 'dresses', 'shoes', 'bags', 'accessories')"
        },
        "items_accessory_check": {
          "name": "items_accessory_check",
          "value": "\"items\".\"accessory_id\" in ('necklaces', 'earrings', 'hair-accessories', 'hats', 'scarves', 'watches', 'rings', 'bracelets', 'brooches', 'belts', 'eyewear')"
        },
        "items_color_names_check": {
          "name": "items_color_names_check",
          "value": "jsonb_typeof(\"items\".\"color_names\") = 'array'"
        },
        "items_color_hexes_check": {
          "name": "items_color_hexes_check",
          "value": "jsonb_typeof(\"items\".\"color_hexes\") = 'array'"
        },
        "items_style_ids_check": {
          "name": "items_style_ids_check",
          "value": "jsonb_typeof(\"items\".\"style_ids\") = 'array' and \"items\".\"style_ids\" <@ '[\"french\",\"quiet-luxury\",\"british\",\"preppy\",\"vintage\",\"gentleman\",\"minimalist\",\"japanese-minimal\",\"mori\",\"korean\",\"nordic\",\"clean-fit\",\"american-casual\",\"amekaji\",\"city-boy\",\"streetwear\",\"skate\",\"y2k\",\"workwear\",\"athleisure\",\"techwear\",\"outdoor\",\"tennis\",\"yoga-pilates\",\"sweet\",\"balletcore\",\"cottagecore\",\"bohemian\",\"gentle-intellectual\",\"dopamine\",\"dark\",\"punk\",\"rock\",\"hip-hop\",\"deconstruction\",\"neo-chinese\",\"japanese-traditional\",\"ethnic\",\"business-formal\",\"business-casual\",\"commuter\",\"resort\",\"party\",\"home\"]'::jsonb"
        },
        "items_season_ids_check": {
          "name": "items_season_ids_check",
          "value": "jsonb_typeof(\"items\".\"season_ids\") = 'array' and \"items\".\"season_ids\" <@ '[\"spring\",\"summer\",\"autumn\",\"winter\"]'::jsonb"
        },
        "items_zone_requires_wardrobe_check": {
          "name": "items_zone_requires_wardrobe_check",
          "value": "\"items\".\"zone_id\" is null or \"items\".\"wardrobe_id\" is not null"
        },
        "items_complete_metadata_check": {
          "name": "items_complete_metadata_check",
          "value": "\"items\".\"status\" = 'draft' or (\"items\".\"wardrobe_id\" is not null and \"items\".\"zone_id\" is not null and length(trim(\"items\".\"name\")) > 0 and \"items\".\"category_id\" is not null and \"items\".\"added_on\" is not null)"
        },
        "items_watch_dates_check": {
          "name": "items_watch_dates_check",
          "value": "(\"items\".\"status\" = 'watching' and \"items\".\"watch_started_on\" is not null and \"items\".\"watch_due_on\" is not null and \"items\".\"watch_due_on\" >= \"items\".\"watch_started_on\") or (\"items\".\"status\" <> 'watching' and \"items\".\"watch_started_on\" is null and \"items\".\"watch_due_on\" is null)"
        }
      },
      "isRLSEnabled": false
    },
